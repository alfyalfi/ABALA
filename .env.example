# Supabase Configuration (Optional - for cloud sync & analytics)
# If left blank, ABALA runs seamlessly in offline-first mode using device storage.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side Supabase Key for Vercel Functions (Optional)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
